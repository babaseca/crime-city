{
  "schemaVersion": "1.1",
  "separationOfConcerns": {
    "domainEventFirst": true,
    "narrativeConsumesImmutableSnapshot": true,
    "narrativeCannotChangeOutcome": true
  },
  "supportedTeamSizes": [
    1,
    2,
    3
  ],
  "speakerSafety": {
    "validRoles": [
      "hero",
      "villain",
      "dispatcher",
      "comando",
      "civilian",
      "narrator"
    ],
    "rules": [
      "Never emit heroB or heroC when team size does not provide them.",
      "Never resolve hero:2 or hero:3 without bounds checking.",
      "dispatcher and comando are explicit speakers and never remapped to a hero.",
      "If a requested speaker is unavailable, use narrator fallback and log FALLBACK_SPEAKER.",
      "A captured, unconscious or absent character cannot speak unless event context explicitly allows remote communication."
    ],
    "fallback": {
      "speakerRole": "narrator",
      "text": "A situação muda antes que alguém consiga responder."
    }
  },
  "selectionPipeline": [
    "1. Receive finalized domain event and immutable context snapshot.",
    "2. Build tags from mission, characters, moral conflicts, relationships, state, intel and custody history.",
    "3. Filter templates by eventType, required context and speaker availability.",
    "4. Score by tag match, relationship salience, unresolved memory, voice compatibility and cooldown.",
    "5. Select with seeded deterministic RNG among top three.",
    "6. Resolve placeholders through safe resolvers; missing optional values use neutral clauses.",
    "7. Emit narrative line, explanation trace and no domain mutations."
  ],
  "tagSources": {
    "mission": [
      "type",
      "ethicalTags",
      "civilianRisk band",
      "collateral band",
      "visibility"
    ],
    "character": [
      "personality facets",
      "voice",
      "moral axes",
      "triggers",
      "redLines",
      "powerLimits"
    ],
    "relationship": [
      "state",
      "axes > 60 or < -35",
      "top unresolved memory",
      "debt"
    ],
    "dynamicState": [
      "stress bands",
      "fatigue bands",
      "morale bands",
      "injury",
      "guilt debt"
    ],
    "alpha12": [
      "intel confidence",
      "informant reliability",
      "custody failure",
      "rehab history",
      "interrogation cost"
    ]
  },
  "salienceRules": [
    {
      "when": "redLine conflict",
      "priority": 100
    },
    {
      "when": "relationship memory weight >= 70",
      "priority": 90
    },
    {
      "when": "stress >= 75 and trigger match",
      "priority": 85
    },
    {
      "when": "power limit crossed",
      "priority": 80
    },
    {
      "when": "intel changed mission outcome",
      "priority": 75
    },
    {
      "when": "relationship axis crossed a threshold",
      "priority": 70
    }
  ],
  "placeholderResolvers": {
    "heroA": "primary actor or narrator fallback",
    "heroB": "secondary actor if available",
    "leader": "mission leader or comando",
    "villain": "target actor",
    "relationshipMemory": "highest salience unresolved memory between referenced characters",
    "moralConflict": "plain-language comparison between mission demand and strongest conflicting axis",
    "redLine": "matched character red line",
    "powerA": "actor powerSummary compressed to action phrase",
    "powerLimitA": "matched power limit",
    "intelConfidence": "integer plus band",
    "civilianRisk": "integer plus band"
  },
