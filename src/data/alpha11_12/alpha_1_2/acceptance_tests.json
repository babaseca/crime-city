        "state becomes corroborated or actionable",
        "mission/countermeasure unlock emitted"
      ]
    },
    {
      "id": "A12_005",
      "given": "custody needs unmet and concrete control fails",
      "when": "escape occurs",
      "then": [
        "failed control listed",
        "no unexplained random escape",
        "case status transitions to escaped"
      ]
    },
    {
      "id": "A12_006",
      "given": "rehab attendance high but accountability zero",
      "when": "stage review runs",
      "then": [
        "stage does not advance"
      ]
    },
    {
      "id": "A12_007",
      "given": "technical relapse disclosed voluntarily",
      "when": "relapse protocol resolves",
      "then": [
        "progress partially preserved",
        "honesty may increase",
        "safeguards revised"
      ]
    },
    {
      "id": "A12_008",
      "given": "mentor stress above eligibility maximum",
      "when": "new assignment attempted",
