{
  "suite": "ALPHA_1_2_ACCEPTANCE",
  "tests": [
    {
      "id": "A12_001",
      "given": "weak evidence and controlled pressure",
      "when": "interrogation resolves",
      "then": [
        "cooperation may rise",
        "truth reliability falls",
        "false intel is possible",
        "legal and moral costs persist"
      ]
    },
    {
      "id": "A12_002",
      "given": "rapport hook matched for Ferrolho and family safety is verified",
      "when": "rapport interrogation resolves",
      "then": [
        "cooperation bonus applies",
        "family is not threatened",
        "intel provenance points to session"
      ]
    },
    {
      "id": "A12_003",
      "given": "intel from one motivated source",
      "when": "mission unlock evaluated",
      "then": [
        "not automatically actionable",
        "corroboration requirement visible"
      ]
    },
    {
      "id": "A12_004",
      "given": "two independent sources corroborate claim",
